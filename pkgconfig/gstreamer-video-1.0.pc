prefix=/Library/Frameworks/GStreamer.framework/Versions/1.0
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: GStreamer Video Library
Description: Video helper functions and base classes
Version: 1.24.1
Requires: gstreamer-1.0 gstreamer-base-1.0
Libs: -L${libdir} -lgstvideo-1.0
Cflags: -I${includedir}/gstreamer-1.0
